# ============================================================================
# HydraClip Environment Configuration
# ============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://hydraclip:hydraclip@localhost:5432/hydraclip

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hydraclip

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Credentials
ADMIN_EMAIL=admin@hydraclip.com
ADMIN_PASSWORD=adminpassword123

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CREATOR_PRICE_ID=price_creator_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback

# AI Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PIPER_MODEL_PATH=/models/piper
WHISPER_MODEL_SIZE=tiny

# OpenRouter (LLM planning for video scripts)
# Get a key at https://openrouter.ai/keys - leave empty to use the built-in fallback plan
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# Unsplash (background photos for rendered videos)
# Get a key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Remotion render service
# "free-license" is valid for individuals and companies of up to 3 people.
# Larger companies need a Remotion Company License key.
REMOTION_LICENSE_KEY=free-license
REMOTION_IS_PRODUCTION=false
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_SECONDS=1800

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Feature Flags
MAINTENANCE_MODE=false
ENABLE_YOUTUBE_PUBLISH=true
ENABLE_INSTAGRAM_EXPORT=true
ENABLE_TIKTOK_EXPORT=true
ENABLE_X_EXPORT=true
ENABLE_AI_IMAGES=false
ENABLE_VOICE_CLONING=false

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_GENERAL=30
RATE_LIMIT_GENERATION=3

# Plan Limits
FREE_VIDEO_LIMIT=3
CREATOR_VIDEO_LIMIT=25
PRO_VIDEO_LIMIT=-1
STORAGE_LIMIT_FREE_GB=1
STORAGE_LIMIT_CREATOR_GB=10
STORAGE_LIMIT_PRO_GB=50