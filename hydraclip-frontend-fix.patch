+                    <p className="mt-1 text-xs text-destructive">{post.error_message}</p>
+                  )}
+                  {post.platform_url && (
+                    <a
+                      href={post.platform_url}
+                      target="_blank"
+                      rel="noreferrer"
+                      className="mt-1 inline-block text-xs text-brand-bright underline"
+                    >
+                      View post
+                    </a>
+                  )}
+                </li>
+              ))}
+            </ul>
+          )}
+        </section>
+      </div>
+    </main>
+  );
 }
