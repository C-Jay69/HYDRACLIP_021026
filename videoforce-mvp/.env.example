# Database
ENVIRONMENT=development
DATABASE_URL=postgresql://videoforce:secret@localhost:5432/videoforce

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage for finished renders (MinIO, S3, R2, Spaces...).
# "local" keeps renders on the worker's disk: fine for development, but
# Instagram and TikTok fetch the video from a URL, so they cannot publish
# until this is "s3".
STORAGE_BACKEND=local
# Internal address, used for uploading.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videoforce
S3_REGION=us-east-1
# MinIO has no per-bucket DNS, so addresses must be path-style. Set false
# for real AWS S3.
S3_FORCE_PATH_STYLE=true
# Public HTTPS address of the bucket, used to sign the URLs handed to
# providers. The signature covers the hostname, so an internal address
# cannot be swapped for a public one afterwards -- this must be the
# address the provider will actually fetch. Leave blank to sign against
# MINIO_ENDPOINT (only works if that is already publicly reachable).
MEDIA_PUBLIC_BASE_URL=
# Providers queue downloads, so this needs to outlive the queue. 24h.
MEDIA_URL_EXPIRY_SECONDS=86400
# Keep the local scratch render after a successful upload.
MEDIA_RETAIN_LOCAL=false

# Application
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=86400

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKey
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecret

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpass

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Piper TTS
PIPER_MODEL_PATH=/models/piper

# Whisper STT
WHISPER_MODEL_SIZE=base

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKey

# --- Stock media providers ----------------------------------------------------
# Video assembly needs at least ONE of these. They are tried in the order
# given by STOCK_PROVIDER_ORDER and the first configured one that returns a
# match wins, so a single key is enough to render.
#
#   Pexels    free, photos AND video, portrait filter on both, no watermark.
#             Best default. 200 req/hour. https://www.pexels.com/api/
#   Pixabay   free, photos and video, no watermark. Video search has no
#             orientation filter. 100 req/60s, results must be cached 24h.
#             https://pixabay.com/api/docs/
#   Unsplash  free, photos only. 50 req/hour until your app is approved.
#             https://unsplash.com/documentation
#
# All three require crediting the source; the renderer records the
# photographer and page URL on every clip it uses.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Shutterstock. Optional and deliberately last: search results are *comp*
# previews with a visible watermark, and clearing it needs a paid licensing
# call this codebase does not make. Renders that use it are flagged as
# drafts and must not be published.
SHUTTERSTOCK_API_TOKEN=your_shutterstock_oauth_token_here

# Preference order for the above.
STOCK_PROVIDER_ORDER=pexels,pixabay,unsplash,shutterstock

# --- Video output -------------------------------------------------------------
# Vertical by default, matching Shorts / Reels / TikTok.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
SUBTITLES_ENABLED=true
SUBTITLE_FONT_SIZE=56

# Leave blank to find ffmpeg on PATH. The API image installs it with apt; for
# a local checkout without it, `pip install imageio-ffmpeg` is picked up
# automatically.
FFMPEG_BINARY=
FFPROBE_BINARY=

# Encryption key for stored OAuth tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank the key is derived from SECRET_KEY, which means rotating
# SECRET_KEY will strand every connected account.
TOKEN_ENCRYPTION_KEY=

# OAuth (social platforms)
# These redirect URIs must match exactly what is registered in each
# provider's developer console. The path is /oauth/{platform}/callback --
# the API mounts no /api prefix.
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/oauth/instagram/callback

TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8000/oauth/tiktok/callback

X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:8000/oauth/x/callback

# SMTP for email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password

# --- Background jobs ---------------------------------------------------------
# inline = run generation inside the API process (development only; in-flight
# work is lost on restart). celery = dispatch to the worker fleet.
JOB_RUNNER=celery

# Both default to REDIS_URL when blank.
CELERY_BROKER_URL=redis://redis:6379/0
# Celery reads the scheme as a backend module name, so a database backend
# needs the "db+" prefix.
CELERY_RESULT_BACKEND=db+postgresql://videoforce:secret@postgres:5432/videoforce

WORKER_CONCURRENCY=2
# Scratch space for intermediate render artefacts; swept by celery beat.
MEDIA_WORK_DIR=/tmp/videoforce
JOB_TIMEOUT_SECONDS=900
