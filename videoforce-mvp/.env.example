# Database
DATABASE_URL=postgresql://videoforce:secret@localhost:5432/videoforge

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videoforce

# Application
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=86400

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKey
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecret

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpass

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Piper TTS
PIPER_MODEL_PATH=/models/piper

# Whisper STT
WHISPER_MODEL_SIZE=base

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKey

# Shutterstock
SHUTTERSTOCK_API_TOKEN=your_shutterstock_oauth_token_here

# OAuth (social platforms)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback

TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8000/api/oauth/tiktok/callback

X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:8000/api/oauth/x/callback

# SMTP for email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password